# ~/.config/zsh/prompt
# Configura o prompt via Starship.
#
# O visual (preset "Pastel Powerline" + relógio com coração ♡) fica no
# starship.toml versionado neste repo. NÃO regeneramos o toml a cada
# shell de propósito: assim as customizações (coração, quebra de linha,
# character ❯) não são apagadas. Pra recomeçar de um preset limpo:
#   starship preset pastel-powerline -o ~/.config/starship.toml
#
# Presets disponíveis em: https://starship.rs/presets/

eval "$(starship init zsh)"
